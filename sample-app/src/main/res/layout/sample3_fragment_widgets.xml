<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:viewBindingIgnore="true">

    <dev.oneuiproject.oneui.widget.ProgressiveBlurLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:blurTop="false"
        app:blurBottom="true">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/widgets_scroll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="always"
        android:scrollbars="vertical"
        android:clipToPadding="false"
        android:paddingBottom="88dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.SeslSwitchBar
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <dev.oneuiproject.oneui.widget.Separator
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Compound Buttons" />

        <dev.oneuiproject.oneui.widget.RoundLinearLayout
            android:layout_marginHorizontal="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/oui_background_color" android:tag="oneui.palette.background"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp">

            <androidx.appcompat.widget.SwitchCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="6dp"
                android:checked="true"
                android:text="Switch" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="6dp"
                android:checked="true"
                android:text="CheckBox" />

            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatRadioButton
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RadioButton" />

                <androidx.appcompat.widget.AppCompatRadioButton
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RadioButton" />

            </RadioGroup>

        </dev.oneuiproject.oneui.widget.RoundLinearLayout>

        <dev.oneuiproject.oneui.widget.Separator
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Buttons" />

        <dev.oneuiproject.oneui.widget.RoundLinearLayout
            android:layout_marginHorizontal="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/oui_background_color" android:tag="oneui.palette.background"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="8dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/fragment_btn_1"
                style="?attr/buttonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:clickable="true"
                android:focusable="true"
                android:text="Button" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/fragment_btn_2"
                style="@style/OneUI.ButtonStyleColored"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:clickable="true"
                android:focusable="true"
                android:text="Button" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/fragment_btn_3"
                style="@style/OneUI.ButtonStyleTransparent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:clickable="true"
                android:focusable="true"
                android:text="Button" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/fragment_btn_4"
                style="@style/OneUI.AppInfoButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:clickable="true"
                android:focusable="true"
                android:text="Button" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/fragment_btn_5"
                style="@style/OneUI.ButtonStyleOutline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:clickable="true"
                android:focusable="true"
                android:text="Button" />

        </dev.oneuiproject.oneui.widget.RoundLinearLayout>

        <dev.oneuiproject.oneui.widget.Separator
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Spinner" />

        <dev.oneuiproject.oneui.widget.RoundFrameLayout
            android:layout_marginHorizontal="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/oui_background_color" android:tag="oneui.palette.background"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/fragment_spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </dev.oneuiproject.oneui.widget.RoundFrameLayout>

        <dev.oneuiproject.oneui.widget.Separator
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Floating search" />

        <dev.oneuiproject.oneui.widget.RoundLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:background="@color/oui_background_color" android:tag="oneui.palette.background"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/widgets_show_floating_search"
                style="?attr/buttonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Show floating search" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/widgets_persistent_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Persistent search bar" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/widgets_ai_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI search bar" />
        </dev.oneuiproject.oneui.widget.RoundLinearLayout>

    </LinearLayout>

    </androidx.core.widget.NestedScrollView>
    </dev.oneuiproject.oneui.widget.ProgressiveBlurLayout>

    <ScrollView
        android:id="@+id/widgets_search_results"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/oui_background_color" android:tag="oneui.palette.background"
        android:visibility="gone"
        android:paddingBottom="88dp">
        <LinearLayout
            android:id="@+id/widgets_search_result_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp" />
    </ScrollView>

    <dev.oneuiproject.oneui.widget.FloatingSearchBar
        android:id="@+id/widgets_floating_search"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        app:searchPersistent="false"
        app:searchAiMode="false" />

</FrameLayout>
