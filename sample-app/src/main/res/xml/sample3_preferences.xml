<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <dev.oneuiproject.oneui.preference.TipsCardPreference
        android:key="tip"
        android:title="TipsCardPreference"
        android:summary="This is a test summary."/>

    <PreferenceCategory />

    <dev.oneuiproject.oneui.preference.SwitchBarPreference />

    <PreferenceCategory>

        <dev.oneuiproject.oneui.preference.HorizontalRadioPreference
            android:key="dark_mode"
            android:title="Dark mode settings"
            app:entries="@array/preferences_darkmode_entries"
            app:entriesImage="@array/preferences_darkmode_entries_image"
            app:entryValues="@array/preferences_darkmode_values"
            app:viewType="image" />

        <SwitchPreferenceCompat
            android:key="dark_mode_auto"
            android:title="System default" />

        <SwitchPreferenceCompat
            android:key="global_blur_enabled"
            android:title="Blur effects"
            android:summary="Blur floating bars, search, dialogs and scroll edges"
            android:defaultValue="true" />

        <SwitchPreferenceCompat
            android:key="global_use_color_palette"
            android:title="Use system color palette"
            android:summary="Use your device theme colors. Turn off to use the custom colors below."
            android:defaultValue="true" />

        <dev.oneuiproject.oneui.preference.OneUISliderPreference
            android:key="global_blur_intensity"
            android:title="Blur intensity"
            android:summary="Adjust how soft the live background appears"
            android:dependency="global_blur_enabled"
            app:minValue="0" app:maxValue="40"
            android:defaultValue="18" />

        <dev.oneuiproject.oneui.preference.OneUISliderPreference
            android:key="global_blur_alpha"
            android:title="Glass opacity"
            android:summary="Adjust surface opacity in 5% steps"
            android:dependency="global_blur_enabled"
            app:minValue="0" app:maxValue="100" app:stepSize="5"
            app:showTicks="true"
            android:defaultValue="65" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="oneui_palette_category"
        android:title="Default OneUI palette"
        android:summary="Customize colors for the current light or dark mode" />

    <PreferenceCategory>

        <SwitchPreferenceCompat
            android:key="key1"
            android:title="SwitchPreference"
            android:defaultValue="false" />

        <SeslSwitchPreferenceScreen
            android:key="key2"
            android:title="SwitchPreferenceScreen"
            android:defaultValue="true" />

        <CheckBoxPreference
            android:key="key3"
            android:title="CheckBoxPreference"
            android:summary="Someone's still using this one?"
            android:defaultValue="true" />

        <dev.oneuiproject.oneui.preference.OneUISliderPreference
            android:key="slider_preference"
            android:title="Slider"
            android:summary="Drag to change the value"
            app:minValue="0" app:maxValue="50"
            android:defaultValue="30" />

    </PreferenceCategory>

    <PreferenceCategory>

        <EditTextPreference
            android:key="key4"
            android:title="EditTextPreference"
            android:defaultValue="Default text"
            app:useSimpleSummaryProvider="true" />

        <DropDownPreference
            android:key="key5"
            android:title="DropDownPreference"
            android:entries="@array/preferences_test_entries"
            android:entryValues="@array/preferences_test_values"
            android:defaultValue="#00FFFF"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:key="key6"
            android:title="ListPreference"
            android:entries="@array/preferences_test_entries"
            android:entryValues="@array/preferences_test_values"
            android:defaultValue="#F0FFFF"
            app:useSimpleSummaryProvider="true" />

        <MultiSelectListPreference
            android:key="key7"
            android:title="MultiSelectListPreference"
            android:summary="Summary"
            android:entries="@array/preferences_test_entries"
            android:entryValues="@array/preferences_test_values" />

    </PreferenceCategory>

    <PreferenceCategory>

        <dev.oneuiproject.oneui.preference.ColorPickerPreference
            android:key="key8"
            android:title="ColorPickerPreference"
            android:summary="Summary"
            android:defaultValue="#0381FE"
            app:showAlphaSlider="true" />

        <dev.oneuiproject.oneui.preference.OneUISliderPreference
            android:key="stepped_slider_preference"
            android:title="Stepped slider"
            android:summary="Choose one of six values"
            app:minValue="0" app:maxValue="5" app:stepSize="1"
            app:showTicks="true" app:sliderFillEnabled="false"
            android:defaultValue="2" />

    </PreferenceCategory>

</PreferenceScreen>
